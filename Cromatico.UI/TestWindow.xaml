<Window x:Class= "Cromatico.UI.TestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Test Ishihara"
    Height="600"
    Width="800">
    
    <Grid>
        <StackPanel Margin="20">
            <TextBlock
                Name="txtNumeroLamina"
                FontSize="20"
                FontWeight="Bold"/>

            <Image
                Name="imgLamina"
                Width="500"
                Height="350"
                Stretch="Uniform"
                Margin="0,20,0,20"/>
                    
            <TextBlock
                Text="Escriba el numero que es visible"/>

            <TextBox
                Name="txtRespuesta"
                Width="200"/>

            <Button
                Name="btnSiguiente"
                Content="Siguiente"
                Width="150"
                Margin="0,20,0,0"
                Click="BtnSiguiente_Click"/>

        </StackPanel>

    </Grid>
</Window>
