<Window x:Class= "Cromatico.UI.VentanaR6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Requerimiento 6"
    Height="600"
    Width="800">
    
    <Grid>
        <StackPanel Margin="20">
            <TextBlock
                Text="Aplicacion"/>

            <TextBox
                Name="txtAplicacion"
                FontSize="20"/>

            <TextBlock
                Text="Ruta"/>

            <TextBox
                Name="txtRuta"
                FontSize="20"/>

            <TextBlock
                Text="Perfil"/>

            <ComboBox
                Name="cmbPerfiles"
                FontSize="20"
                FontWeight="Bold"/>
            
            <Button
                Name="btnBuscarAplicacion"
                Content="BuscarAplicacion"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,20,0,0"
                Click="btnBuscarAplicacion_Click"/>

            <Button
                Name="btnAsociar"
                Content="Asociar"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,20,0,0"
                Click="btnAsociar_Click"/>

            <TextBlock
                Text="Lista de Aplicaciones asociadas"/>

            <ListBox
                Name="lstAsociaciones"
                Height="150"/>
            
            <Button
                Name="btnEliminar"
                Content="Eliminar"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,20,0,0"
                Click="btnEliminar_Click"/>

            

        </StackPanel>

    </Grid>
</Window>