<Window x:Class="Cromatico.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cromático" Width="1120" Height="740" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource EstiloVentana}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,24,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource GradienteEspectro}">
                        <TextBlock Text="C" FontWeight="Bold" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CROMÁTICO" FontWeight="Bold" FontSize="15" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="BarraPestanas" Grid.Column="1" Orientation="Horizontal"/>

                <Border Grid.Column="2" Margin="0,0,20,0" Padding="12,6" CornerRadius="14" VerticalAlignment="Center"
                        Background="{StaticResource BrushTarjeta}" BorderBrush="{StaticResource BrushBorde}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TextoCuenta" Foreground="{StaticResource BrushTexto}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextoNube" Foreground="{StaticResource BrushTextoSec}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="Contenido" Grid.Row="1" Focusable="False"/>

        <Border x:Name="BarraAviso" Grid.Row="2" Visibility="Collapsed" Padding="20,10"
                Background="{StaticResource BrushPanel}" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextoAviso" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource BotonFantasma}" Padding="10,4"
                        Click="AlCerrarAviso"/>
            </Grid>
        </Border>
    </Grid>
</Window>
