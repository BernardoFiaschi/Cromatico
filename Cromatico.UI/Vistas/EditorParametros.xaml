<UserControl x:Class="Cromatico.Vistas.EditorParametros"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="EJE DE CORRECCIÓN" Style="{StaticResource EtiquetaSeccion}"/>
        <ComboBox x:Name="ComboEje" SelectionChanged="AlCambiarEje" AutomationProperties.Name="Eje de corrección"/>

        <TextBlock Text="TIPO DE DEFICIENCIA" Style="{StaticResource EtiquetaSeccion}" Margin="0,16,0,6"/>
        <ComboBox x:Name="ComboTipo" SelectionChanged="AlCambiarTipo" AutomationProperties.Name="Tipo de deficiencia"/>

        <Grid Margin="0,20,0,0">
            <TextBlock Text="SEVERIDAD" Style="{StaticResource EtiquetaSeccion}" Margin="0"/>
            <TextBlock x:Name="ValorSeveridad" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
        <Slider x:Name="DeslizadorSeveridad" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AlCambiarValor"
                AutomationProperties.Name="Severidad"/>
        <TextBlock Text="Cuánto afecta la deficiencia a la percepción de color." Style="{StaticResource Subtitulo}"
                   FontSize="12"/>

        <Grid Margin="0,18,0,0">
            <TextBlock Text="INTENSIDAD DE LA CORRECCIÓN" Style="{StaticResource EtiquetaSeccion}" Margin="0"/>
            <TextBlock x:Name="ValorIntensidad" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
        <Slider x:Name="DeslizadorIntensidad" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AlCambiarValor"
                AutomationProperties.Name="Intensidad de la corrección"/>
        <TextBlock Text="Qué tanto se aplica el cambio de color a la imagen." Style="{StaticResource Subtitulo}"
                   FontSize="12"/>
    </StackPanel>
</UserControl>
