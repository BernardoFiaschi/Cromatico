<Window x:Class="Cromatico.Vistas.VentanaInicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cromático" Width="460" Height="640" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Style="{StaticResource EstiloVentana}">
    <Grid Margin="40,32,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource GradienteEspectro}"
                    HorizontalAlignment="Center">
                <TextBlock Text="C" FontSize="34" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="CROMÁTICO" FontSize="22" FontWeight="Bold" Margin="0,14,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Corrección de color para daltonismo" Style="{StaticResource Subtitulo}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,0">
            <UniformGrid Columns="2" Margin="-2,0">
                <RadioButton x:Name="OpcionIngresar" Content="Iniciar sesión" IsChecked="True"
                             GroupName="Modo" Style="{StaticResource OpcionSegmentada}" Checked="AlCambiarModo"/>
                <RadioButton x:Name="OpcionRegistrar" Content="Crear cuenta"
                             GroupName="Modo" Style="{StaticResource OpcionSegmentada}" Checked="AlCambiarModo"/>
            </UniformGrid>

            <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource EtiquetaSeccion}" Margin="0,22,0,6"/>
            <TextBox x:Name="CajaEmail" AutomationProperties.Name="Correo electrónico"/>

            <TextBlock Text="CONTRASEÑA" Style="{StaticResource EtiquetaSeccion}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="CajaPassword" AutomationProperties.Name="Contraseña" KeyDown="AlTeclearPassword"/>
            <TextBlock x:Name="AyudaPassword" Style="{StaticResource Subtitulo}" FontSize="12" Margin="0,6,0,0"
                       Text="Mínimo 8 caracteres, con letras y números." Visibility="Collapsed"/>

            <Button x:Name="BotonPrincipal" Content="Iniciar sesión" Style="{StaticResource BotonPrimario}"
                    Margin="0,22,0,0" Click="AlPulsarPrincipal" IsDefault="True"/>

            <Border x:Name="PanelMensaje" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,12"
                    CornerRadius="6" BorderThickness="1" Background="{StaticResource BrushTarjeta}">
                <StackPanel>
                    <TextBlock x:Name="TextoMensaje" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PanelAcciones" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="BotonCrearDesdeError" Content="Crear cuenta nueva" Visibility="Collapsed"
                                Click="AlPulsarCrearDesdeError"/>
                        <Button x:Name="BotonContinuarLocal" Content="Continuar sin iniciar sesión" Margin="0,8,0,0"
                                Click="AlPulsarContinuarLocal"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border Height="1" Background="{StaticResource BrushBorde}" Margin="0,0,0,14"/>
            <Button x:Name="BotonSinCuenta" Content="Usar sin cuenta" Style="{StaticResource BotonFantasma}"
                    Click="AlPulsarSinCuenta"/>
            <TextBlock Text="Sin cuenta, tus perfiles quedan solo en este equipo."
                       Style="{StaticResource Subtitulo}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
