<UserControl x:Class="Cromatico.Vistas.PaginaAjustes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Ajustes" Style="{StaticResource TituloPagina}"/>
            <TextBlock Text="Cuenta, sincronización y datos locales." Style="{StaticResource Subtitulo}" Margin="0,4,0,22"/>

            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Cuenta" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TextoCuenta" FontSize="15" Margin="0,10,0,0"/>
                    <TextBlock x:Name="TextoEstado" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="BotonSincronizar" Content="Sincronizar ahora" Click="AlPulsarSincronizar"/>
                        <Button x:Name="BotonCerrarSesion" Content="Cerrar sesión" Margin="8,0,0,0" Click="AlPulsarCerrarSesion"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Datos en este equipo" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Subtitulo}" Margin="0,6,0,0"
                               Text="Perfiles, perfil activo y asociaciones se guardan en este archivo:"/>
                    <TextBox x:Name="CajaRuta" IsReadOnly="True" Margin="0,8,0,0" AutomationProperties.Name="Ubicación de los datos"/>
                    <TextBlock Style="{StaticResource Subtitulo}" Margin="0,10,0,0" FontSize="12"
                               Text="Si el archivo está dañado, Cromático lo conserva como copia (.danado.bak) y arranca con los perfiles predefinidos."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
