<UserControl x:Class="Cromatico.Vistas.PaginaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Inicio" Style="{StaticResource TituloPagina}"/>
            <TextBlock Text="Estado actual de la corrección de color en este equipo."
                       Style="{StaticResource Subtitulo}" Margin="0,4,0,22"/>

            <Border Style="{StaticResource Tarjeta}" Padding="0">
                <Grid>
                    <Border Height="4" VerticalAlignment="Top" CornerRadius="8,8,0,0"
                            Background="{StaticResource GradienteEspectro}"/>
                    <StackPanel Margin="26,28,26,24">
                        <TextBlock Text="PERFIL EN USO AHORA" Style="{StaticResource EtiquetaSeccion}"/>
                        <TextBlock x:Name="TextoPerfil" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TextoOrigen" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TextoResumen" Foreground="{StaticResource BrushTextoSec}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Perfil automático por aplicación" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Cambia de perfil según la aplicación que tengas en primer plano."
                                           Style="{StaticResource Subtitulo}" Margin="0,4,12,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="InterruptorAuto" Grid.Column="1" Style="{StaticResource Interruptor}"
                                          VerticalAlignment="Top" Click="AlPulsarAuto"
                                          AutomationProperties.Name="Perfil automático por aplicación"/>
                        </Grid>
                        <TextBlock x:Name="TextoEstadoAuto" FontWeight="SemiBold" Margin="0,12,0,0"/>

                        <Border Height="1" Background="{StaticResource BrushBorde}" Margin="0,18,0,16"/>

                        <TextBlock Text="APLICACIÓN EN PRIMER PLANO" Style="{StaticResource EtiquetaSeccion}"/>
                        <TextBlock x:Name="TextoVentana" FontSize="15"/>
                        <TextBlock x:Name="TextoRuta" Style="{StaticResource Subtitulo}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Perfil global" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Subtitulo}" Margin="0,4,0,14"
                                   Text="Se usa cuando la aplicación activa no tiene un perfil asociado o no se puede identificar."/>
                        <ComboBox x:Name="ComboGlobal" SelectionChanged="AlElegirGlobal" AutomationProperties.Name="Perfil global"/>
                        <Button Content="Ajustar en la vista previa" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Click="AlPulsarAjustar"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cuenta y sincronización" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TextoCuenta" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BotonSincronizar" Grid.Column="1" Content="Sincronizar ahora" Click="AlPulsarSincronizar"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
