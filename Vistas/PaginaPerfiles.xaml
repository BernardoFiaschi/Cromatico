<UserControl x:Class="Cromatico.Vistas.PaginaPerfiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Perfiles" Style="{StaticResource TituloPagina}"/>
            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,4,0,18"
                       Text="Natural y Preciso vienen incluidos. Para crear uno propio, duplicá un perfil y ajustalo en la vista previa."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="BotonUsar" Content="Usar este perfil" Style="{StaticResource BotonPrimario}" Click="AlPulsarUsar" Margin="0,0,8,8"/>
            <Button x:Name="BotonAjustar" Content="Ajustar en vista previa" Click="AlPulsarAjustar" Margin="0,0,8,8"/>
            <Button x:Name="BotonDuplicar" Content="Duplicar / Nuevo" Click="AlPulsarDuplicar" Margin="0,0,8,8"/>
            <Button x:Name="BotonRenombrar" Content="Renombrar" Click="AlPulsarRenombrar" Margin="0,0,8,8"/>
            <Button x:Name="BotonEliminar" Content="Eliminar" Click="AlPulsarEliminar" Margin="0,0,8,8"/>
        </WrapPanel>

        <ListBox x:Name="Lista" Grid.Row="2" SelectionChanged="AlCambiarSeleccion" MaxWidth="900"
                 HorizontalAlignment="Stretch" AutomationProperties.Name="Lista de perfiles">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold"/>
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource BrushBordeFuerte}" BorderThickness="1">
                                    <TextBlock Text="{Binding Etiqueta}" FontSize="11" Foreground="{StaticResource BrushTextoSec}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Resumen}" Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,4" CornerRadius="12" VerticalAlignment="Center"
                                Background="{StaticResource BrushAcento}" Visibility="{Binding VisibleActivo}">
                            <TextBlock Text="★ ACTIVO" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
