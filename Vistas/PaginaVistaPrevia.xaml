<UserControl x:Class="Cromatico.Vistas.PaginaVistaPrevia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Cromatico.Vistas">
    <Grid Margin="32,28,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Vista previa" Style="{StaticResource TituloPagina}"/>
                <TextBlock Text="Ajustá los parámetros y mirá el resultado al instante."
                           Style="{StaticResource Subtitulo}" Margin="0,4,0,18"/>

                <Border Style="{StaticResource Tarjeta}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PERFIL" Style="{StaticResource EtiquetaSeccion}"/>
                        <ComboBox x:Name="ComboPerfil" SelectionChanged="AlElegirPerfil" AutomationProperties.Name="Perfil"/>
                        <TextBlock x:Name="TextoPerfilNota" Style="{StaticResource Subtitulo}" FontSize="12" Margin="0,6,0,18"/>

                        <v:EditorParametros x:Name="Editor"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BotonGuardar" Content="Guardar en el perfil" Margin="0,14,0,0" Click="AlPulsarGuardar"/>
                <Button x:Name="BotonGuardarAplicar" Content="Guardar y aplicar" Style="{StaticResource BotonPrimario}"
                        Margin="0,8,0,0" Click="AlPulsarGuardarAplicar"/>
                <TextBlock Style="{StaticResource Subtitulo}" FontSize="12" Margin="0,8,0,0"
                           Text="Los perfiles predefinidos no se modifican: al guardar se crea una copia personalizada."/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="BotonCapturar" Content="Capturar pantalla" Click="AlPulsarCapturar"/>
                <Button x:Name="BotonReferencia" Content="Imagen de referencia" Margin="8,0,0,0" Click="AlPulsarReferencia"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ORIGINAL" Style="{StaticResource EtiquetaSeccion}"/>
                        <Image x:Name="ImagenOriginal" Grid.Row="1" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Imagen original"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CORREGIDA" Style="{StaticResource EtiquetaSeccion}"/>
                        <Image x:Name="ImagenCorregida" Grid.Row="1" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Imagen corregida"/>
                        <TextBlock x:Name="TextoNoDisponible" Grid.Row="1" Visibility="Collapsed"
                                   Text="Vista previa no disponible" FontSize="16"
                                   Foreground="{StaticResource BrushTextoSec}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="PanelMensaje" Grid.Row="2" Margin="0,14,0,0" Padding="14,10" CornerRadius="6"
                    BorderThickness="1" Background="{StaticResource BrushTarjeta}" Visibility="Collapsed">
                <TextBlock x:Name="TextoMensaje" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
